/* ==============================================================================
   Global & Layout
   ============================================================================== */
* {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    font-size: 13px;
    color: #1D1D1F;
}

QMainWindow, QWidget#centralWidget {
    background: #F5F5F7; /* Mac-style light gray background */
}

QDialog {
    background: #F5F5F7;
}

QTextEdit, QPlainTextEdit, QLineEdit {
    selection-background-color: #E8E8ED;
    selection-color: #1D1D1F;
}

/* ==============================================================================
   Header
   ============================================================================== */
#headerFrame {
    background: transparent;
    border: none;
}

#titleLabel {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.3px;
}

#subtitleLabel {
    font-size: 12px;
    color: #86868B;
}

#versionLabel {
    font-size: 12px;
    color: #86868B;
    margin-right: 8px;
}

/* ==============================================================================
   Cards
   ============================================================================== */
QFrame[card="true"] {
    background: #FFFFFF;
    border-radius: 12px;
    /* Use a very thin border to simulate box-shadow */
    border: 1px solid #E5E5EA; 
}

QFrame[card="true"] QLabel[panelTitle="true"] {
    font-size: 14px;
    font-weight: 600;
    color: #1D1D1F;
}

/* ==============================================================================
   Buttons
   ============================================================================== */
QPushButton {
    background-color: #1D1D1F;
    color: #FFFFFF;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
    border: none;
    outline: none; /* Remove system focus dotted line */
}
QPushButton:hover { background-color: #333336; }
QPushButton:pressed { background-color: #000000; }
QPushButton:disabled { background-color: #E5E5EA; color: #AEAEB2; }

/* Secondary buttons */
QPushButton[secondary="true"] {
    background-color: #E5E5EA;
    color: #1D1D1F;
}
QPushButton[secondary="true"]:hover { background-color: #D1D1D6; }

/* Flat buttons (e.g., Expand/Collapse) */
QPushButton[flat="true"] {
    background-color: transparent;
    color: #86868B;
    padding: 4px 8px;
    font-weight: 500;
    outline: none;
}
QPushButton[flat="true"]:hover {
    color: #1D1D1F;
    background-color: #E5E5EA;
    border-radius: 6px;
}

/* ==============================================================================
   Inputs & Search
   ============================================================================== */
QLineEdit, QComboBox {
    background: #F5F5F7;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 12px;
    color: #1D1D1F;
    selection-background-color: #1D1D1F;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QComboBox:hover { background: #EFEFF1; }
QLineEdit:focus, QComboBox:focus {
    background: #FFFFFF;
    border: 1px solid #D2D2D7;
}

/* Ensure ComboBox dropdown list matches the modern style */
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #E5E5EA;
    border-radius: 8px;
    outline: none;
    selection-background-color: #1D1D1F;
    selection-color: #FFFFFF;
}

/* Search input specific */
#searchInput {
    background: #F5F5F7;
    border-radius: 8px;
    padding: 8px 12px;
}
#searchInput:focus {
    background: #FFFFFF;
    border: 1px solid #D2D2D7;
}

/* ==============================================================================
   Tree Widget
   ============================================================================== */
QTreeWidget {
    background: #FFFFFF;
    border: none;
    outline: none;
}

/* Clear default branch background and constrain width to reduce gap */
QTreeView::branch {
    background: transparent;
    border: none;
    outline: none;
    width: 16px; 
}

QTreeView::branch:closed:has-children {
    image: url(ui/icons/arrow_right.svg);
    padding-left: 4px;
}

QTreeView::branch:open:has-children {
    image: url(ui/icons/arrow_down.svg);
    padding-left: 4px;
}

QTreeWidget::item {
    padding: 8px 6px;
    border-radius: 0px;
    color: #1D1D1F;
    margin-bottom: 0px;
}

QTreeWidget::item:hover {
    background: #F5F5F7;
}

QTreeWidget::item:selected {
    background: #E8E8ED;
    color: #1D1D1F;
    font-weight: 500;
}

/* ==============================================================================
   Checkbox & Tree Widget Indicators
   ============================================================================== */
QCheckBox {
    spacing: 8px;
    color: #1D1D1F;
}

/* Shared styles for standalone checkboxes and tree item checkboxes */
QCheckBox::indicator, 
QTreeView::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1.5px solid #D2D2D7;
    background: #FFFFFF;
}

/* Pull the tree checkbox closer to the expand/collapse arrow */
QTreeView::indicator {
    margin-left: -4px; 
}

QCheckBox::indicator:hover, 
QTreeView::indicator:hover {
    border: 1.5px solid #1D1D1F;
}

QCheckBox::indicator:checked, 
QTreeView::indicator:checked {
    background: #FFFFFF;
    border: 1.5px solid #1D1D1F;
    image: url(ui/icons/check.svg); 
}

/* ==============================================================================
   Log Text Edit
   ============================================================================== */
#logTextEdit {
    background: #1E1E1E;
    color: #D4D4D4;
    border-radius: 8px;
    padding: 16px;
    font-family: "SF Mono", Consolas, "Courier New", monospace;
    font-size: 12px;
    border: none;
    outline: none;
}

/* ==============================================================================
   Status Bar & Progress
   ============================================================================== */
#statusBarFrame {
    background: #FFFFFF;
    border-top: 1px solid #E5E5EA;
}

#statusLabel, #progressLabel {
    font-size: 12px;
    color: #86868B;
}

QProgressBar#progressBar {
    background: #E5E5EA;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar#progressBar::chunk {
    background: #1D1D1F;
    border-radius: 3px;
}

/* Status Value (Pill style) */
#statusValue {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 12px;
    background: #E5E5EA;
    color: #1D1D1F;
    font-weight: 600;
}
#statusValue[status="ready"] {
    background: #E5E5EA;
    color: #1D1D1F;
}
#statusValue[status="running"] {
    background: #FFF3E0;
    color: #E65100;
}
#statusValue[status="done"] {
    background: #E8F5E9;
    color: #2E7D32;
}
#statusValue[status="error"] {
    background: #FFEBEE;
    color: #C62828;
}

/* ==============================================================================
   ToolTip
   ============================================================================== */
QToolTip {
    background: #1D1D1F;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}

/* ==============================================================================
   Scrollbars
   ============================================================================== */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #D2D2D7;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #AEAEB2;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #D2D2D7;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::corner {
    background: transparent;
}